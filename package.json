{
  "name": "labcar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LAB CAR Est\u00e9tica Automotriz \u2014 sistema web",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "mock:seed": "node scripts/mock-data.ts seed",
    "mock:clear": "node scripts/mock-data.ts clear",
    "mock:preview": "node scripts/mock-data.ts preview",
    "seed:catalog": "node scripts/seed-catalog.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "firebase": "^12.19.0",
    "material-symbols": "^0.47.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
