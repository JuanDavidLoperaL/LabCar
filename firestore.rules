rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de apoyo ----------

    // Correo de la sesión en minúsculas (los IDs de users/ están en minúsculas).
    function sessionEmail() {
      return request.auth.token.email.lower();
    }

    // Usuarios sin correo propio, creados por el administrador.
    function isInternalAccount() {
      return sessionEmail().matches('.*@usuarios[.]labcar[.]local$');
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // El perfil le pertenece a quien inició sesión. Se exige correo verificado (Google siempre lo
    // está) para que nadie pueda registrarse con el correo de otra persona y heredar su perfil.
    // Excepción: cuentas con contraseña que creó el administrador (access == 'password'): si alguien
    // hubiera creado antes una cuenta con ese correo, el administrador no habría podido crearla.
    function ownsProfile(profile) {
      return request.auth.token.email_verified == true
        || isInternalAccount()
        || profile.get('access', '') == 'password';
    }

    // Perfil activo con uno de los roles indicados (admin | manager | basic).
    function hasRole(roles) {
      let profile = get(/databases/$(database)/documents/users/$(sessionEmail())).data;
      return signedIn() && ownsProfile(profile) && profile.active == true && profile.role in roles;
    }

    function isMember() {
      return hasRole(['admin', 'manager', 'basic']);
    }

    // Medianoche de hoy en Colombia (UTC-5), con 15 min de tolerancia por
    // diferencias de reloj del dispositivo.
    function isToday(date) {
      let bogotaMidnight = (request.time - duration.value(5, 'h')).date() + duration.value(5, 'h');
      return date >= bogotaMidnight - duration.value(15, 'm');
    }

    function counterPath() {
      return /databases/$(database)/documents/counters/sales;
    }

    function salePath(number) {
      return /databases/$(database)/documents/sales/$('LC-' + string(number));
    }

    // Reparto de la comisión: cada vendedor recibe una parte igual (±1 peso por redondeo),
    // las partes suman exactamente la comisión y cada vendedor es un usuario del sistema.
    // Solo aritmética entera: parte × n debe quedar a menos de n pesos de la comisión.
    function isValidSeller(d, i) {
      let n = d.sellers.size();
      let share = d.sellers[i].commission;
      return d.sellers[i].keys().hasOnly(['email', 'name', 'commission'])
        && d.sellers[i].email == d.sellerEmails[i]
        && d.sellers[i].name is string
        && share is int
        && share * n > d.commission - n
        && share * n < d.commission + n
        && exists(/databases/$(database)/documents/users/$(d.sellerEmails[i]));
    }

    function isValidSellers(d) {
      let n = d.sellers.size();
      let s = d.sellers;
      return n >= 1 && n <= 4
        && d.sellerEmails is list && d.sellerEmails.size() == n
        && isValidSeller(d, 0)
        && (n < 2 || isValidSeller(d, 1))
        && (n < 3 || isValidSeller(d, 2))
        && (n < 4 || isValidSeller(d, 3))
        && ((n == 1 && s[0].commission == d.commission)
          || (n == 2 && s[0].commission + s[1].commission == d.commission)
          || (n == 3 && s[0].commission + s[1].commission + s[2].commission == d.commission)
          || (n == 4 && s[0].commission + s[1].commission + s[2].commission + s[3].commission == d.commission));
    }

    function isValidInvoice(invoice) {
      return invoice.keys().hasOnly(['status', 'recipient', 'number', 'cufe', 'pdfUrl', 'error'])
        && ((invoice.status == 'not-requested' && invoice.recipient == null)
          || (invoice.status == 'pending' && invoice.recipient in ['customer', 'final-consumer']))
        && invoice.number == null && invoice.cufe == null && invoice.pdfUrl == null && invoice.error == null;
    }

    // Venta nueva coherente. Cuando exista la Firebase Function, ella registrará
    // las ventas (y validará cada servicio) y estas reglas quedarán como respaldo.
    function isValidNewSale(saleId) {
      let d = request.resource.data;
      let rate = get(/databases/$(database)/documents/settings/commissions).data.rate;
      return d.keys().hasOnly(['number', 'requestId', 'date', 'vehicleType', 'plate', 'vehicleLine', 'items',
          'subtotal', 'discount', 'total', 'commissionRate', 'commission', 'sellers', 'sellerEmails',
          'paymentMethod', 'status', 'payment', 'customer', 'invoice', 'notes', 'createdBy', 'void'])
        // Consecutivo: es el valor que deja el contador en la misma transacción.
        && d.number is int
        && d.number == getAfter(counterPath()).data.value
        && saleId == 'LC-' + string(d.number)
        // Registro de idempotencia creado en la misma transacción (evita ventas duplicadas al reintentar).
        && d.requestId is string
        && getAfter(/databases/$(database)/documents/saleRequests/$(d.requestId)).data.saleId == saleId
        && d.date == request.time
        && d.vehicleType in ['car', 'motorcycle']
        && d.plate is string && d.plate.matches('^[A-Z0-9]{3,10}$')
        && d.vehicleLine is string && d.vehicleLine.size() >= 2 && d.vehicleLine.size() <= 60
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 20
        && d.subtotal is int && d.discount is int && d.total is int
        && d.discount >= 0 && d.total >= 0 && d.total == d.subtotal - d.discount
        // Comisión: la tasa vigente sobre el valor facturado.
        && d.commissionRate == rate
        && d.commission is int
        && d.commission - d.total * rate <= 0.5
        && d.total * rate - d.commission <= 0.5
        && isValidSellers(d)
        && d.paymentMethod in ['cash', 'transfer', 'credit']
        && ((d.paymentMethod == 'credit' && d.status == 'pending' && d.customer != null)
          || (d.paymentMethod != 'credit' && d.status == 'paid'))
        // El pago de un crédito solo se registra después, desde cartera (isValidSettlement).
        && d.payment == null
        && isValidInvoice(d.invoice)
        && d.notes is string && d.notes.size() <= 250
        && d.createdBy.keys().hasOnly(['email', 'name'])
        && d.createdBy.email == sessionEmail()
        && d.void == null;
    }

    // Anulación: solo cambia status → void y registra quién, cuándo y por qué.
    function isValidVoid() {
      let d = request.resource.data;
      return resource.data.status != 'void'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'void'])
        && d.status == 'void'
        && d.void.keys().hasOnly(['at', 'by', 'reason'])
        && d.void.at == request.time
        && d.void.by == sessionEmail()
        && d.void.reason is string && d.void.reason.size() >= 5 && d.void.reason.size() <= 200;
    }

    // Pago total de una venta a crédito desde cartera (no hay abonos): pasa de pending → paid
    // y registra cuándo (hora del servidor), cómo y quién lo registró. Nada más de la venta cambia.
    function isValidSettlement() {
      let d = request.resource.data;
      return resource.data.status == 'pending'
        && resource.data.paymentMethod == 'credit'
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'payment'])
        && d.status == 'paid'
        && d.payment.keys().hasOnly(['at', 'method', 'by'])
        && d.payment.at == request.time
        && d.payment.method in ['cash', 'transfer']
        && d.payment.by.keys().hasOnly(['email', 'name'])
        && d.payment.by.email == sessionEmail()
        && d.payment.by.name is string && d.payment.by.name.size() <= 100;
    }

    // Días para que un crédito entre en mora (lo cambia solo el administrador desde Cartera).
    function isValidReceivablesSettings() {
      let d = request.resource.data;
      return d.keys().hasOnly(['overdueDays', 'updatedAt', 'updatedBy'])
        && d.overdueDays is int && d.overdueDays >= 1 && d.overdueDays <= 365
        && d.updatedAt == request.time
        && d.updatedBy == sessionEmail();
    }

    // Pago de comisiones a un empleado (solo admin, desde Pagos Vendedores). ID = "{día del corte}_{correo}":
    // un pago por empleado y semana. Cubre las ventas del empleado con fecha en [coveredFrom, coveredTo).
    function isValidPayout(payoutId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['weekId', 'sellerEmail', 'sellerName', 'coveredFrom', 'coveredTo', 'saleIds',
          'amount', 'paidAt', 'paidBy'])
        && d.weekId is string && d.weekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.sellerEmail is string
        && payoutId == d.weekId + '_' + d.sellerEmail
        && exists(/databases/$(database)/documents/users/$(d.sellerEmail))
        && d.sellerName is string && d.sellerName.size() <= 100
        && d.coveredTo is timestamp && d.coveredTo <= request.time
        && (d.coveredFrom == null || (d.coveredFrom is timestamp && d.coveredFrom < d.coveredTo))
        && d.saleIds is list && d.saleIds.size() >= 1 && d.saleIds.size() <= 500
        && d.amount is int && d.amount > 0
        && d.paidAt == request.time
        && d.paidBy.keys().hasOnly(['email', 'name'])
        && d.paidBy.email == sessionEmail()
        && d.paidBy.name is string && d.paidBy.name.size() <= 100;
    }

    // Decisión de no pagar una semana y acumular el saldo a la siguiente (solo admin). Mismo ID que el pago.
    // Es solo un registro: el saldo se arrastra igual.
    function isValidDeferral(deferralId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['weekId', 'sellerEmail', 'sellerName', 'amount', 'deferredAt', 'deferredBy'])
        && d.weekId is string && d.weekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.sellerEmail is string
        && deferralId == d.weekId + '_' + d.sellerEmail
        && exists(/databases/$(database)/documents/users/$(d.sellerEmail))
        && d.sellerName is string && d.sellerName.size() <= 100
        && d.amount is int && d.amount > 0
        && d.deferredAt == request.time
        && d.deferredBy.keys().hasOnly(['email', 'name'])
        && d.deferredBy.email == sessionEmail()
        && d.deferredBy.name is string && d.deferredBy.name.size() <= 100;
    }

    // Gasto nuevo: de hoy (hora del servidor) o, solo el admin, un día pasado de hasta 60 días
    // (se guarda al mediodía de ese día; se dan 61 por la diferencia de horas).
    function isValidNewExpense() {
      let d = request.resource.data;
      let todayMidnight = (request.time - duration.value(5, 'h')).date() + duration.value(5, 'h');
      return d.keys().hasOnly(['date', 'description', 'amount', 'paymentMethod', 'createdAt', 'createdBy', 'void'])
        && (d.date == request.time
          || (hasRole(['admin']) && d.date is timestamp
            && d.date < todayMidnight && d.date > request.time - duration.value(61, 'd')))
        && d.description is string && d.description.size() >= 3 && d.description.size() <= 200
        && d.amount is int && d.amount >= 1 && d.amount <= 50000000
        && d.paymentMethod in ['cash', 'transfer']
        && d.createdAt == request.time
        && d.createdBy.keys().hasOnly(['email', 'name'])
        && d.createdBy.email == sessionEmail()
        && d.createdBy.name is string && d.createdBy.name.size() <= 100
        && d.void == null;
    }

    // Anulación de un gasto: solo agrega quién, cuándo y por qué (los gastos de prueba no traen el campo void).
    function isValidExpenseVoid() {
      let d = request.resource.data;
      return resource.data.get('void', null) == null
        && d.diff(resource.data).affectedKeys().hasOnly(['void'])
        && d.void.keys().hasOnly(['at', 'by', 'reason'])
        && d.void.at == request.time
        && d.void.by.keys().hasOnly(['email', 'name'])
        && d.void.by.email == sessionEmail()
        && d.void.by.name is string && d.void.by.name.size() <= 100
        && d.void.reason is string && d.void.reason.size() >= 5 && d.void.reason.size() <= 200;
    }

    function isValidServiceName(name) {
      return name is string && name.size() >= 2 && name.size() <= 60;
    }

    // Perfil que guarda el administrador desde Usuarios y Roles. Nunca el suyo propio: así no puede
    // quitarse el rol de admin ni eliminarse por error y dejar el sistema sin administrador.
    function isValidUserProfile(email) {
      let d = request.resource.data;
      return email != sessionEmail()
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && d.role in ['admin', 'manager', 'basic']
        && d.get('access', 'google') in ['google', 'password']
        && d.active is bool
        && d.updatedAt == request.time
        && d.updatedBy == sessionEmail();
    }

    function isValidContactField(value) {
      return value is string && value.matches('^[0-9]{0,15}$');
    }

    // ---------- Usuarios ----------
    // ID = correo en minúsculas (usuarios sin correo: usuario@usuarios.labcar.local).
    // Todo el equipo puede ver la lista: son los vendedores que se eligen en cada venta.
    // access: 'google' (entra con Google) | 'password' (cuenta con contraseña que creó el admin).
    // Solo el admin agrega, cambia el rol y elimina (active = false). No se borran: las ventas
    // y los pagos de comisiones los siguen nombrando.
    match /users/{email} {
      allow get: if signedIn() && ((sessionEmail() == email && (resource == null || ownsProfile(resource.data))) || isMember());
      allow list: if isMember();
      allow create: if hasRole(['admin'])
        && email == email.lower()
        && email.matches('^[^@\\s]+@[^@\\s]+$')
        && request.resource.data.keys().hasOnly(['name', 'role', 'access', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.active == true
        && isValidUserProfile(email);
      allow update: if hasRole(['admin'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'access', 'active', 'updatedAt', 'updatedBy'])
        && isValidUserProfile(email);
      allow delete: if false;
    }

    // ---------- Datos de contacto de los empleados ----------
    // Cédula y teléfono (ID = correo). Van aparte de users/ porque users/ lo lee todo el equipo.
    // El admin los registra al agregar un usuario (o con scripts/employee.ts).
    match /employees/{email} {
      allow get: if hasRole(['admin', 'manager']) || (isMember() && sessionEmail() == email);
      allow list: if hasRole(['admin', 'manager']);
      allow create, update: if hasRole(['admin'])
        && existsAfter(/databases/$(database)/documents/users/$(email))
        && request.resource.data.keys().hasOnly(['documentNumber', 'phone'])
        && isValidContactField(request.resource.data.get('documentNumber', ''))
        && isValidContactField(request.resource.data.get('phone', ''));
      allow delete: if false;
    }

    // ---------- Catálogo y configuración ----------
    // Catálogo de servicios: solo el admin lo cambia desde Servicios. Se borran de verdad (las ventas
    // guardan el nombre). El máximo de 5 accesos rápidos lo controla la app.
    match /services/{serviceId} {
      allow read: if isMember();
      allow create: if hasRole(['admin'])
        && request.resource.data.keys().hasOnly(['name', 'quick'])
        && isValidServiceName(request.resource.data.name)
        && request.resource.data.quick == false;
      allow update: if hasRole(['admin'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'quick'])
        && isValidServiceName(request.resource.data.name)
        && request.resource.data.quick is bool;
      allow delete: if hasRole(['admin']);
    }

    match /settings/{settingId} {
      allow read: if isMember();
      allow create, update: if settingId == 'receivables' && hasRole(['admin']) && isValidReceivablesSettings();
      allow delete: if false;
    }

    // ---------- Consecutivo de ventas ----------
    // Solo puede avanzar de uno en uno y junto con la venta de ese número.
    match /counters/sales {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value == 1
        && existsAfter(salePath(1));
      allow update: if isMember()
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value == resource.data.value + 1
        && existsAfter(salePath(request.resource.data.value));
    }

    // ---------- Registros de idempotencia ----------
    // Un registro por intento de venta (ID generado al abrir el formulario). Si la respuesta
    // de Firestore se pierde y el usuario reintenta, la transacción encuentra este registro
    // y devuelve la venta ya creada en vez de duplicarla.
    match /saleRequests/{requestId} {
      allow get: if isMember() && (resource == null || resource.data.createdBy == sessionEmail());
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['saleId', 'createdBy'])
        && request.resource.data.createdBy == sessionEmail()
        && getAfter(/databases/$(database)/documents/sales/$(request.resource.data.saleId)).data.requestId == requestId;
      allow update, delete: if false;
    }

    // ---------- Ventas ----------
    // Admin y manager ven todas; basic solo aquellas en las que es vendedor
    // (o que registró, para poder imprimir el recibo). Nunca se borran: se anulan.
    match /sales/{saleId} {
      allow get: if hasRole(['admin', 'manager'])
        || (hasRole(['basic'])
          && (sessionEmail() in resource.data.sellerEmails || resource.data.createdBy.email == sessionEmail()));
      allow list: if hasRole(['admin', 'manager'])
        || (hasRole(['basic']) && sessionEmail() in resource.data.sellerEmails);
      allow create: if isMember() && isValidNewSale(saleId);
      allow update: if hasRole(['admin', 'manager']) && (isValidVoid() || isValidSettlement());
      allow delete: if false;
    }

    // ---------- Pagos de comisiones ----------
    // Admin y manager ven los de todos; basic solo los suyos. Solo el admin registra pagos;
    // nunca se editan ni se borran desde la app (un error se corrige con un script).
    match /commissionPayouts/{payoutId} {
      allow read: if hasRole(['admin', 'manager'])
        || (hasRole(['basic']) && resource.data.sellerEmail == sessionEmail());
      allow create: if hasRole(['admin']) && isValidPayout(payoutId);
      allow update, delete: if false;
    }

    match /payoutDeferrals/{deferralId} {
      allow read: if hasRole(['admin', 'manager'])
        || (hasRole(['basic']) && resource.data.sellerEmail == sessionEmail());
      allow create: if hasRole(['admin']) && isValidDeferral(deferralId);
      allow update, delete: if false;
    }

    // ---------- Gastos ----------
    // Admin ve todos; manager solo los de hoy. Ambos registran (el manager solo con fecha de hoy) y
    // anulan (el manager solo los de hoy). Nunca se borran. get admite documentos inexistentes para
    // que la transacción de createExpense compruebe si el intento ya se guardó.
    match /expenses/{expenseId} {
      allow get: if hasRole(['admin'])
        || (hasRole(['manager']) && (resource == null || isToday(resource.data.date)));
      allow list: if hasRole(['admin'])
        || (hasRole(['manager']) && isToday(resource.data.date));
      allow create: if hasRole(['admin', 'manager']) && isValidNewExpense();
      allow update: if (hasRole(['admin']) || (hasRole(['manager']) && isToday(resource.data.date)))
        && isValidExpenseVoid();
      allow delete: if false;
    }
  }
}
